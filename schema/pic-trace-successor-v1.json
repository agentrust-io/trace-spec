{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trace.agentrust-io.com/schema/pic-trace-successor-v1.json",
  "title": "PIC/TRACE Successor Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "authorization_id",
    "observer",
    "observer_key_id",
    "observed_at",
    "successor_observation_digest",
    "signature"
  ],
  "properties": {
    "profile": {
      "const": "tag:agentrust-io.com,2026:pic-trace-successor-v1"
    },
    "authorization_id": {
      "type": "string",
      "minLength": 1
    },
    "observer": {
      "type": "string",
      "minLength": 1
    },
    "observer_key_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "successor_observation_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  }
}
